{
	"name": "obsidian-reminder-telegram",
	"version": "1.0.8",
	"description": "Sends Telegram notifications when your Obsidian tasks reach their deadline. Features customizable message templates and Markdown formatting.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"prepare": "husky",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run --reporter=verbose"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^25.7.0",
		"@vitest/coverage-v8": "^3.2.6",
		"esbuild": "0.28.0",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "17.6.0",
		"husky": "^9.1.7",
		"jiti": "2.7.0",
		"jsdom": "^25.0.1",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.6",
		"tslib": "2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.60.0",
		"vitest": "^3.2.6"
	},
	"dependencies": {
		"obsidian": "^1.13.1"
	}
}
